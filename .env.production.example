APP_NAME="Promo System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://promo.example.com
APP_TIMEZONE=Asia/Yerevan

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=promo_system
DB_USERNAME=promo_system
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=promo.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@promo.example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=promo.example.com

# Required production campaign window; interpreted in APP_TIMEZONE.
CAMPAIGN_START_AT=2026-01-01 00:00:00
CAMPAIGN_END_AT=2026-12-31 23:59:59

# Required legal/public identity values shown on the landing page.
VITE_APP_NAME="${APP_NAME}"
VITE_ORGANIZER_NAME=
VITE_PRIVACY_CONTACT_EMAIL=

# Cloudflare Turnstile must be enabled and use production keys.
VITE_TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_EXPECTED_HOSTNAME=promo.example.com
TURNSTILE_EXPECTED_ACTION=receipt-submit
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"

# Production draws use Random.org. Run promo:random-org-smoke before release.
RANDOM_PROVIDER=random_org
RANDOM_ORG_API_KEY=

# Never seed demo campaign data in production.
SEED_DATASET=none

# Used by the one-time production seed. Rotate after initial provisioning.
ADMIN_NAME="Promotion Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=
