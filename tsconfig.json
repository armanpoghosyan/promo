{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],

        "allowJs": true,
        "checkJs": false,

        "skipLibCheck": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,

        "isolatedModules": true,
        "moduleDetection": "force",

        "jsx": "react-jsx",

        "noEmit": true,

        "strict": false,
        "noImplicitAny": false,
        "strictNullChecks": false,

        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "vite-env.d.ts",
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "vite.config.js"
    ],
    "exclude": [
        "node_modules",
        "public",
        "vendor"
    ]
}
