APP_NAME="Promo System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Yerevan

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=promo_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_TURNSTILE_ENABLED=false
VITE_ORGANIZER_NAME="Promotion Organizer"
VITE_PRIVACY_CONTACT_EMAIL="privacy@example.com"

# Required in production. Values are interpreted in APP_TIMEZONE.
CAMPAIGN_START_AT=
CAMPAIGN_END_AT=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=receipt-submit
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"

# Random provider:
# local = development/testing
# random_org = production Random.org integration
RANDOM_PROVIDER=local
RANDOM_ORG_API_KEY=

# Database seed dataset:
# none  = production-safe core data only
# light = small dataset for API/business-flow testing
# full  = realistic mid-campaign dataset for UI development
# Never enable in production.
SEED_DATASET=none

ADMIN_NAME="Promotion Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=
